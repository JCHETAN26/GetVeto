{
  "name": "getveto",
  "version": "0.1.1",
  "description": "Veto is a local safety layer for Claude Code and other AI coding agents: it reviews each tool call against rules and, in guard mode, blocks the dangerous ones. Your agent proposes. You veto.",
  "keywords": [
    "claude-code",
    "claude",
    "hooks",
    "ai-agents",
    "ai-safety",
    "agent-safety",
    "guardrails",
    "safety",
    "security",
    "pretooluse",
    "llm",
    "devtools",
    "cli"
  ],
  "homepage": "https://github.com/JCHETAN26/GetVeto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCHETAN26/GetVeto.git"
  },
  "bugs": {
    "url": "https://github.com/JCHETAN26/GetVeto/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "veto": "dist/cli.js",
    "getveto": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json && node scripts/bundle.mjs",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node ./node_modules/vitest/vitest.mjs run",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "capture-fixtures": "node scripts/capture-fixtures.mjs",
    "redteam:setup": "node redteam/setup.mjs",
    "redteam:stats": "npm run -s build && node scripts/redteam-stats.mjs",
    "bench": "npm run -s build && node scripts/bench-hook.mjs --only-pre --bash && node scripts/bench-hook.mjs --only-pre --non-bash && node scripts/bench-hook.mjs --only-pre --bash --guard && node scripts/bench-hook.mjs --only-pre --non-bash --guard && node scripts/bench-parse.mjs",
    "eval": "npm run -s build && node scripts/eval-rules.mjs",
    "bench:competitive": "npm run -s build && node scripts/bench-competitive.mjs",
    "demo": "node scripts/demo.mjs",
    "redteam:fixtures": "node scripts/generate-redteam-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "typescript": "~5.9.3",
    "unbash": "6.0.2",
    "vitest": "~3.2.7"
  }
}
